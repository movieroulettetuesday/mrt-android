<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Optional new-episode alert (local notification only; asked when the user turns it on). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- No advertising ID: strip it even if a dependency ever adds it. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <!-- Where-to-watch chips ask if these apps are installed (ProviderLaunch). API 30+ hides packages that are not listed here. -->
    <queries>
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.netflix.ninja" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.apple.atve.androidtv.appletv" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.hulu.plus" />
        <package android:name="com.cbs.ott" />
        <package android:name="com.peacocktv.peacockandroid" />
        <package android:name="com.tubitv" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="com.google.android.apps.youtube.unplugged" />
        <package android:name="com.mubi" />
        <package android:name="tv.pluto.android" />
        <package android:name="com.dramafever.shudder" />
        <package android:name="com.google.android.videos" />
        <package android:name="air.com.vudu.air.DownloaderTablet" />
        <package android:name="com.plexapp.android" />
    </queries>

    <application
        android:name=".MrtApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MRT"
        android:usesCleartextTraffic="false"
        tools:targetApi="36">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MRT">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".widget.SpinOfTheDayWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/spin_of_the_day_widget_info" />
        </receiver>
    </application>
</manifest>
